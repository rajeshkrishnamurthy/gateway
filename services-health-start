#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$ROOT_DIR/backend"
PID_FILE="$ROOT_DIR/.services-health.pid"
LOG_FILE="$ROOT_DIR/.services-health.log"

if [[ -f "$PID_FILE" ]]; then
  existing_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  if [[ -n "$existing_pid" ]] && kill -0 "$existing_pid" 2>/dev/null; then
    echo "services-health already running (pid $existing_pid)"
    echo "log: $LOG_FILE"
    exit 0
  fi
  rm -f "$PID_FILE"
fi

(
  cd "$BACKEND_DIR"
  nohup go run ./cmd/services-health -config conf/docker/services_health.json -addr :8070 "$@" >>"$LOG_FILE" 2>&1 &
  echo "$!" >"$PID_FILE"
)

new_pid="$(cat "$PID_FILE")"

for _ in {1..15}; do
  if ! kill -0 "$new_pid" 2>/dev/null; then
    echo "error: failed to start services-health (process exited during startup)" >&2
    echo "last log lines:" >&2
    tail -n 40 "$LOG_FILE" >&2 || true
    rm -f "$PID_FILE"
    exit 1
  fi
  sleep 0.2
done

echo "services-health started in background (pid $new_pid)"
echo "log: $LOG_FILE"
